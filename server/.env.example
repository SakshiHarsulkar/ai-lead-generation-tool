# Copy to server/.env (git-ignored). Everything is optional for local development.

# PostgreSQL (e.g. Neon). Leave empty to use the embedded Postgres in server/data/.
DATABASE_URL=

# Enables AI insights (summary, fit reason, personalised opener) for Warm/Hot leads.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_MIN_SCORE=45

# Crawler tuning
# CRAWL_CONCURRENCY=16
# HTTP_TIMEOUT_MS=10000
# MAX_SUBPAGES=3
# CACHE_TTL_HOURS=168
